# PPM deployment settings — TEMPLATE. Do not fill secrets by hand and never commit the real file.
# Create the real file with:  ./ppm-env.sh init --domain <домен> --output .runtime/ppm.env
# (it generates every secret below and the backup passphrase file, mode 600); validate: ./ppm-env.sh check <file>
# RUNBOOK.md §4–7: the file starts in the PRIVATE phase (internal TLS, ports on 127.0.0.1); the owner claims the
# first administrator, then `ppm-env.sh set` switches PPM_TLS to the ACME e-mail and PPM_BIND_ADDRESS to 0.0.0.0.

# ---- Compose project and images
PPM_PROJECT=ppm
PPM_IMAGE_REPO=ppm
# Release tag produced by ppm-build.sh (switching it = upgrade/rollback, see RUNBOOK.md)
PPM_RELEASE=rc.1
# MinIO image is decoupled from the application release (object storage is not restarted on app upgrades)
PPM_MINIO_IMAGE=ppm/minio:rc.1
# Registry host that mirrors Docker Hub (docker.io, or e.g. mirror.gcr.io if Docker Hub is unreachable)
PPM_DOCKERHUB_MIRROR=docker.io

# ---- Public address
PPM_DOMAIN=ppm.example.ru
PPM_HTTP_PORT=80
PPM_HTTPS_PORT=443
# https://<domain> (plus :port when the port is not 443); must be the exact browser origin
PPM_PUBLIC_URL=https://ppm.example.ru
# 127.0.0.1 = private phase (nothing reachable from outside; Docker-published ports bypass ufw), 0.0.0.0 = public
PPM_BIND_ADDRESS=127.0.0.1
# `internal` (Caddy's local CA: private phase, *.localhost drills) or the ACME e-mail (Let's Encrypt, public phase)
PPM_TLS=internal
PPM_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
PPM_HSTS_MAX_AGE=31536000
# Free sign-up stays closed (Plane stores this at the first start; change later in god-mode → Authentication)
PPM_ENABLE_SIGNUP=0

# ---- Sizing (small team)
PPM_GUNICORN_WORKERS=2
PPM_WORKER_CONCURRENCY=2
PPM_FILE_SIZE_LIMIT=5242880
PPM_PROXY_MAX_BODY_SIZE=16MB
# Object storage client bounds (seconds / attempts in total); defaults fail a MinIO outage in ~20 s
PPM_S3_CONNECT_TIMEOUT=5
PPM_S3_READ_TIMEOUT=10
PPM_S3_MAX_ATTEMPTS=2

# ---- RC feature flags (server side; web flags are baked at build time, see ppm-build.sh)
PPM_GIT_WRITE_ENABLED=0
PPM_CANVAS_AUTOMERGE=1

# ---- Backups (ppm-backup.sh): encrypted with the passphrase file (relative to this file's directory)
PPM_BACKUP_PASSPHRASE_FILE=ppm.backup-passphrase
# Newest archives kept by rotation
PPM_BACKUP_KEEP=7
# Optional default output directory (else .runtime/backups); the runbook uses --output-dir /srv/ppm-backups
PPM_BACKUP_DIR=

# ---- Secrets (generated by ppm-env.sh init; hex only; keep a copy in a password manager, not in the backup)
SECRET_KEY=generated-by-ppm-env
LIVE_SERVER_SECRET_KEY=generated-by-ppm-env
POSTGRES_PASSWORD=generated-by-ppm-env
RABBITMQ_PASSWORD=generated-by-ppm-env
MINIO_ACCESS_KEY=generated-by-ppm-env
MINIO_SECRET_KEY=generated-by-ppm-env

# ---- Optional GitHub App (Git integration); empty = Git not configured
PPM_GITHUB_APP_ID=
PPM_GITHUB_APP_SLUG=
PPM_GITHUB_APP_CLIENT_ID=
PPM_GITHUB_CALLBACK_URL=
PPM_GITHUB_APP_CLIENT_SECRET=
PPM_GITHUB_APP_PRIVATE_KEY=
PPM_GITHUB_WEBHOOK_SECRET=
