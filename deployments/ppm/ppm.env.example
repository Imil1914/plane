# PPM deployment settings — TEMPLATE. Do not fill secrets by hand and never commit the real file.
# Create the real file with:  ./ppm-env.sh init --domain <домен> --output .runtime/ppm.env
# (it generates every secret below and the backup passphrase file, mode 600); validate: ./ppm-env.sh check <file>
# RUNBOOK.md §4–7: the file starts in the PRIVATE phase (internal TLS, ports on 127.0.0.1); the owner claims the
# first administrator, then `ppm-env.sh set` switches PPM_TLS to the ACME e-mail and PPM_BIND_ADDRESS to 0.0.0.0.

# ---- Compose project and images
PPM_PROJECT=ppm
PPM_IMAGE_REPO=ppm
# Release tag produced by ppm-build.sh (switching it = upgrade/rollback, see RUNBOOK.md)
PPM_RELEASE=rc.1
# MinIO image is decoupled from the application release (object storage is not restarted on app upgrades)
PPM_MINIO_IMAGE=ppm/minio:rc.1
# Registry host that mirrors Docker Hub (docker.io, or e.g. mirror.gcr.io if Docker Hub is unreachable)
PPM_DOCKERHUB_MIRROR=docker.io

# ---- Public address
PPM_DOMAIN=ppm.example.ru
PPM_HTTP_PORT=80
PPM_HTTPS_PORT=443
# https://<domain> (plus :port when the port is not 443); must be the exact browser origin
PPM_PUBLIC_URL=https://ppm.example.ru
# 127.0.0.1 = private phase (nothing reachable from outside; Docker-published ports bypass ufw), 0.0.0.0 = public
PPM_BIND_ADDRESS=127.0.0.1
# `internal` (Caddy's local CA: private phase, *.localhost drills) or the ACME e-mail (Let's Encrypt, public phase)
PPM_TLS=internal
PPM_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
PPM_HSTS_MAX_AGE=31536000
# Free sign-up stays closed (Plane stores this at the first start; change later in god-mode → Authentication)
PPM_ENABLE_SIGNUP=0

# ---- Sizing (small team)
PPM_GUNICORN_WORKERS=2
PPM_WORKER_CONCURRENCY=2
PPM_FILE_SIZE_LIMIT=5242880
PPM_PROXY_MAX_BODY_SIZE=16MB
# Object storage client bounds (seconds / attempts in total); defaults fail a MinIO outage in ~20 s
PPM_S3_CONNECT_TIMEOUT=5
PPM_S3_READ_TIMEOUT=10
PPM_S3_MAX_ATTEMPTS=2

# ---- RC feature flags (server side; web flags are baked at build time, see ppm-build.sh)
PPM_GIT_WRITE_ENABLED=0
PPM_CANVAS_AUTOMERGE=1

# ---- Backups (ppm-backup.sh): encrypted with the passphrase file (relative to this file's directory)
PPM_BACKUP_PASSPHRASE_FILE=ppm.backup-passphrase
# Newest archives kept by rotation
PPM_BACKUP_KEEP=7
# Optional default output directory (else .runtime/backups); the runbook uses --output-dir /srv/ppm-backups
PPM_BACKUP_DIR=

# ---- Secrets (generated by ppm-env.sh init; hex only; keep a copy in a password manager, not in the backup)
SECRET_KEY=generated-by-ppm-env
LIVE_SERVER_SECRET_KEY=generated-by-ppm-env
POSTGRES_PASSWORD=generated-by-ppm-env
RABBITMQ_PASSWORD=generated-by-ppm-env
MINIO_ACCESS_KEY=generated-by-ppm-env
MINIO_SECRET_KEY=generated-by-ppm-env

# ---- Optional GitHub App (Git integration); empty = Git not configured
PPM_GITHUB_APP_ID=
PPM_GITHUB_APP_SLUG=
PPM_GITHUB_APP_CLIENT_ID=
PPM_GITHUB_CALLBACK_URL=
PPM_GITHUB_APP_CLIENT_SECRET=
PPM_GITHUB_APP_PRIVATE_KEY=
PPM_GITHUB_WEBHOOK_SECRET=

# ---- Monitoring and alerts (ppm-monitor.sh), RUNBOOK §14. Thresholds: absent = these same defaults (no migration
# needed for an older file). Both alert channels are optional; empty = not configured, no error, only the log and
# exit code. Warn/critical disk thresholds trip on percentage OR absolute free space, whichever comes first.
PPM_MONITOR_DISK_WARN_PERCENT=15
PPM_MONITOR_DISK_WARN_GB=10
PPM_MONITOR_DISK_CRIT_PERCENT=5
PPM_MONITOR_DISK_CRIT_GB=3
PPM_MONITOR_BACKUP_MAX_AGE_HOURS=26
PPM_MONITOR_CERT_WARN_DAYS=14
PPM_MONITOR_REMIND_HOURS=6
PPM_MONITOR_HTTP_TIMEOUT=5
# Telegram bot alert channel (RUNBOOK §14.2): token from @BotFather + numeric chat id (negative for a group)
PPM_ALERT_TELEGRAM_BOT_TOKEN=
PPM_ALERT_TELEGRAM_CHAT_ID=
# E-mail alert channel via SMTP (RUNBOOK §14.3); PPM_ALERT_SMTP_TO takes one address or several, comma-separated
PPM_ALERT_SMTP_HOST=
PPM_ALERT_SMTP_PORT=587
PPM_ALERT_SMTP_SECURITY=starttls
PPM_ALERT_SMTP_USER=
PPM_ALERT_SMTP_PASSWORD=
PPM_ALERT_SMTP_FROM=
PPM_ALERT_SMTP_TO=

# ---- Git server of PPM (Forgejo 15 LTS), RUNBOOK §17. `ppm-env.sh init` writes this block; an existing (RC.1) file
# gets only the keys it lacks with `ppm-env.sh add-git <file>` (nothing else in the file changes).
# 1 = Git server on; 0 = off (no Forgejo, no git.<domain> site, no PPM_FORGEJO_* in the API)
PPM_GIT_SERVER_ENABLED=1
# Its own host name (DNS record to the same server) and the exact public URL (https://<host>[:PPM_HTTPS_PORT])
PPM_GIT_DOMAIN=git.ppm.example.ru
PPM_GIT_PUBLIC_URL=https://git.ppm.example.ru
# git over SSH (Forgejo's built-in server), published on PPM_BIND_ADDRESS like 80/443; 0 = HTTPS only
PPM_GIT_SSH_ENABLED=1
PPM_GIT_SSH_PORT=2222
# Largest request body the proxy lets through to the Git server (one git push pack / one LFS object)
PPM_GIT_MAX_BODY_SIZE=1GB
# Migrations (from GitHub only) can be started by anyone who may create repositories: true switches them off
# (set it after the move from GitHub, RUNBOOK §17.7); optional, false when absent
PPM_GIT_DISABLE_MIGRATIONS=false
# Pinned by multi-arch digest, updated apart from PPM releases (RUNBOOK §17.9); the mirror
# data.forgejo.org/forgejo/forgejo:15-rootless@<same digest> serves the same image
PPM_FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15-rootless@sha256:caf1bca332f95cdcf124227a4bfa3b49bbbfbbc8a5e4a97406921cb581165413
# Secrets of the Git server (generated; hex, except the two JWT secrets: base64url of 32 bytes without '=')
FORGEJO_DB_PASSWORD=generated-by-ppm-env
FORGEJO_SECRET_KEY=generated-by-ppm-env
FORGEJO_INTERNAL_TOKEN=generated-by-ppm-env
FORGEJO_JWT_SECRET=generated-by-ppm-env
FORGEJO_LFS_JWT_SECRET=generated-by-ppm-env
PPM_FORGEJO_WEBHOOK_SECRET=generated-by-ppm-env
# PPM's read-only token in Forgejo (read:repository, read:organization, read:user): written by
# `ppm-deploy.sh git-bootstrap`, empty until then
PPM_FORGEJO_TOKEN=

# ---- Sign-in through PPM — single sign-on to the Git server (G2.2), RUNBOOK §17.14. `ppm-env.sh init` writes this
# block; an RC.2 file (Git server keys, no sign-in keys) gets it with `ppm-env.sh add-sso <file>` (nothing else changes).
# 1 = people sign in to the Git server with «Войти через PPM» and PPM keeps their accounts and code access;
# 0 = the Git server's own sign-in, as in G2.1. Only with PPM_GIT_SERVER_ENABLED=1 (switch both off together).
PPM_GIT_SSO_ENABLED=1
# 1 = the Git server's password form is back (emergency administrator, RUNBOOK §17.14.6); 0 = only «Войти через PPM»
PPM_GIT_LOCAL_SIGNIN=0
# The only OAuth2 client of PPM: the Git server (its login source is named exactly PPM)
PPM_OIDC_CLIENT_ID=forgejo
# RS256 signing key: RSA 3072 private key, its PEM in base64 on ONE line (generated; ppm-env.sh rotate-sso-key renews
# it and keeps the previous one below until `rotate-sso-key --finish`)
PPM_OIDC_PRIVATE_KEY=generated-by-ppm-env
PPM_OIDC_PREVIOUS_PRIVATE_KEY=
# Client secret of the Git server (48 hex; ppm-env.sh rotate-sso-secret renews it)
PPM_OIDC_CLIENT_SECRET=generated-by-ppm-env
# Written by `ppm-deploy.sh git-bootstrap`, empty until then: the admin token of ppm-bot (write:admin,
# write:organization, read:repository, read:user — only for PPM's access module) and the id of the login source PPM
PPM_FORGEJO_ADMIN_TOKEN=
PPM_FORGEJO_SSO_SOURCE_ID=
